# ── Next.js build output ──────────────────────────────────────────────────────
.next/
out/

# ── Dependencies ───────────────────────────────────────────────────────────────
node_modules/

# ── Environment variables (never commit secrets) ───────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Vercel deployment metadata ─────────────────────────────────────────────────
.vercel/

# ── OS and editor artifacts ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/settings.json

# ── Package manager debug logs & conflicting locks ────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json

# ── TypeScript build info ──────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts
